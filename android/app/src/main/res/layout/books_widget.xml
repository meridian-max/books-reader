  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:orientation="vertical" android:padding="4dp"><ImageView android:id="@+id/cover3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:scaleType="fitCenter" android:contentDescription="Open third book"/><TextView android:id="@+id/book3" android:layout_width="match_parent" android:layout_height="38dp" android:gravity="center" android:textColor="#263b34" android:textSize="12sp" android:maxLines="2"/></LinearLayout>

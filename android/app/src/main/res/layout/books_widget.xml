<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical"><TextView android:id="@+id/widget_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent" android:gravity="center_vertical" android:text="Books · Your library" android:textColor="#263b34" android:textSize="18sp"/><TextView android:id="@+id/widget_settings" android:layout_width="48dp" android:layout_height="48dp" android:gravity="center" android:text="⚙" android:textColor="#263b34" android:textSize="24sp" android:contentDescription="Widget settings"/></LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center">
